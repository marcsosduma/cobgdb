; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#ifndef DistDir
#define DistDir "..\dist"
#endif

[Setup]
; Basic program information
AppName=WCOBGDB
AppVersion=1.0
AppPublisher=Marcos Martins Duma
AppPublisherURL=https://github.com/marcsosduma/cobgdb
DefaultDirName={autopf}\WCOBGDB
DefaultGroupName=WCOBGDB
; Where the setup.exe will be saved and its name
OutputDir=..\windows
OutputBaseFilename=WCobGDB_Setup
; Maximum compression to keep the installer lightweight
Compression=lzma2/ultra64
SolidCompression=yes
; Allows installing for all users or just the current one
PrivilegesRequiredOverridesAllowed=dialog
ChangesEnvironment=yes

[Registry]
; Adds the installation directory to the system PATH
Root: HKLM; Subkey: "SYSTEM\CurrentControlSet\Control\Session Manager\Environment"; ValueType: expandsz; ValueName: "Path"; ValueData: "{olddata};{app}"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; The asterisk (*) at the end is essential to copy everything inside.
Source: "{#DistDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
; Creates shortcuts pointing DIRECTLY to your executable
Name: "{autodesktop}\WCobGDB"; Filename: "{cmd}"; Parameters: "/K cd /d ""{app}\samples"" && ""{app}\wcobgdb.exe"" --help"; IconFilename: "{app}\wcobgdb.exe"; Tasks: desktopicon

[Run]
; Offers the option to launch the program at the end of the installation
Filename: "{cmd}"; Parameters: "/K cd /d ""{app}"" && wcobgdb.exe --help"; Description: "Open WCOBGDB and show help"; Flags: nowait postinstall skipifsilent